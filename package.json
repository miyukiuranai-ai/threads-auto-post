    "storage:setup": "node scripts/storage-setup.mjs",
    "tick": "node scripts/tick.mjs",
    "templates:import": "node scripts/import-templates.mjs",
    "token:refresh": "node scripts/refresh-tokens.mjs"
  },
  "dependencies": {
    "firebase-admin": "^14.3.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
