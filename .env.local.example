# ============================================================
# threads-auto-post の環境変数テンプレート
# ------------------------------------------------------------
# 使い方:  npm run env:init -- --sa <FirebaseのサービスアカウントJSON> --admin-password <好きなパスワード>
#          （このファイルを手で写しても構いません）
# 値は絶対にコードへ直書きしないこと。.env.local は git に入りません。
# ============================================================

# --- Firebase（docs/SETUP.md の「Firebase」の章）---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# JSON の private_key をそのまま（\n を文字のまま残して）ダブルクォートで囲む
FIREBASE_PRIVATE_KEY=
# 画像・動画の置き場所。省くと <プロジェクトID>.firebasestorage.app
FIREBASE_STORAGE_BUCKET=

# --- 管理画面のログイン ---
ADMIN_USER=admin
ADMIN_PASSWORD=
# 管理者以外の人。user:password:group をカンマ区切り（例: suzuki:pw123:teamB）。使わなければ空
MEMBERS=
# クッキーの署名鍵（ランダムな文字列）
SESSION_SECRET=

# --- 定期実行の鍵（Apps Script / GitHub Actions / Vercel Cron から渡す。ランダムな文字列）---
CRON_SECRET=

# --- 投稿モード: live（実際に投稿。既定）/ dry_run（Threads に送らないで試す）---
POSTING_MODE=live

# --- 画面の URL（Storage の CORS 設定に使う。カンマ区切りで複数可）---
APP_URL=http://localhost:3000
