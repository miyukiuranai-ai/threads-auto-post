{
  "name": "threads-auto-post",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Threads の複数名義を一括で自動投稿するツール（文章ストックからの自動投稿・今すぐ投稿・予約投稿。公式 Threads API のみ使用）",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
